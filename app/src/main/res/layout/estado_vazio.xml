<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vazio de qualquer tela: o que falta e um botão para informar o
     endereço da lista. Fica por cima do conteúdo, que está sem dados. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="120dp"
    android:paddingEnd="120dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_list"
        app:tint="@color/text_faint"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/vazioTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/vazioBotao"
        style="@style/BotaoListas"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="0dp"
        android:text="@string/vazio_botao" />
</LinearLayout>
