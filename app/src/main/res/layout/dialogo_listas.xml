<?xml version="1.0" encoding="utf-8"?>
<!-- Endereço das listas: dois campos e botões grandes, tudo alcançável pelo
     controle (cima/baixo anda, OK edita ou aperta, VOLTAR sai). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="760dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingTop="36dp"
        android:paddingEnd="44dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/listasTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/listas_titulo"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/listasTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/listas_canais"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/listasCanais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:hint="@string/listas_dica_canais"
            android:imeOptions="actionNext|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusDown="@+id/listasFilmes"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/listas_filmes"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/listasFilmes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_campo"
            android:hint="@string/listas_dica_filmes"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:nextFocusDown="@+id/listasSalvar"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_faint"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/listasMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/live"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/listasSalvar"
                style="@style/BotaoListas"
                android:text="@string/listas_salvar" />

            <TextView
                android:id="@+id/listasTentar"
                style="@style/BotaoListas"
                android:text="@string/listas_tentar"
                android:visibility="gone" />

            <TextView
                android:id="@+id/listasMesmoAssim"
                style="@style/BotaoListas"
                android:text="@string/listas_mesmo_assim"
                android:visibility="gone" />

            <TextView
                android:id="@+id/listasRestaurar"
                style="@style/BotaoListas"
                android:text="@string/listas_restaurar" />

            <TextView
                android:id="@+id/listasFechar"
                style="@style/BotaoListas"
                android:text="@string/listas_agora_nao" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
